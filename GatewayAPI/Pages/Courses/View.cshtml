@page "{id}/{idItem?}"
@model GatewayAPI.Pages.Courses.ViewModel
@{
    ViewData["Title"] = $"{Model.CurrentCourse.Title}";
    var currentCourseItemValues = new Dictionary<string, string> {
                    { "id", Model.CurrentCourse.Id },
                    { "order", (Model.CourseItems.Count + 1).ToString() }
    };
}
@Html.AntiForgeryToken()
<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/quizzes.css">
    <link href="/css/site.css" rel="stylesheet" asp-append-version="true">
    <link rel="stylesheet" href="~/node_modules/easymde/dist/easymde.min.css">
    <link rel="stylesheet" href="~/css/easymde.css">
    <link rel="stylesheet" href="~/css/easymde_preview.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
</head>

@section Scripts {
    <script src="~/node_modules/easymde/dist/easymde.min.js"></script>
    <script type="text/javascript" src="/js/view.js"></script>
    <script type="text/javascript" src="/js/quizzes_base.js"></script>
    <script>
        const content = @Html.Raw(Json.Serialize(Model.Contents != null && Model.Contents.Count > 0 ? Model.Contents.First().Data : ""));
        setContent(content);

        const Quiz = @Html.Raw(Json.Serialize(Model.Quiz != null ? Model.Quiz : null));
        const Questions = @Html.Raw(Json.Serialize(Model.Questions != null && Model.Questions.Count > 0 ? Model.Questions : null));
        initQuiz('view');
        setQuizData(Quiz, Questions);
    </script>
    
@*     <script>hljs.highlightAll();</script> *@

}

<div class="course-main">
    <!-- Левая панель с модулями -->

    <div class="sidebar-wrapper">
        <div class="sidebar left-sidebar">
            <div class="text-center medium">Модули курса</div>
            <div>
                <div class="module-list">
                    @foreach (var module in Model.CourseItems)
                    {
                        <div class="module-item-container">
                            <a href="/courses/view/@Model.CurrentCourse.Id/@module.Id"
                               class="module-item">
                                @module.Order. @module.Title
                            </a>
                        </div>
                    }
                    @* <button id="addModuleBtn" class="btn btn-sm btn-outline-primary">+ Добавить модуль</button> *@
                </div>
            </div>
        </div>
    </div>
    <!-- Основная область контента -->
    <div class="main-content" >

        @if (Model.CurrentCourseItem != null)
        {
            <h2 class="display-5">@Model.CurrentCourseItem.Title</h2>
            <h4 class="display-6">@Model.CurrentCourseItem.Type</h4>

            <textarea id="simplemde"></textarea>


            <!-- Основной контейнер с информацией о тесте -->
            <div id="quiz-container" class="card quiz-card" style="display: none;">
                <div class="card-body">
                    <div class="quiz-info">
                        <h2 id="quiz-title-display" class="card-title text-center">Название теста</h2>
                        <div class="d-flex gap-3 text-muted mb-3">
                            <span id="quiz-type-display">Тип: Тест</span>
                            <span id="quiz-id-display"></span>
                        </div>
                        <p id="quiz-description-display" class="card-text">Описание теста...</p>
                    </div>

                    <div class="questions-list mt-4">
                        @*                         <h3>Вопросы теста</h3> *@
                        <div id="questions-container">
                            <div class="no-questions">Нет добавленных вопросов</div>
                        </div>
                        <button type="button" id="submit-quiz" class="btn btn-outline-primary">Отправить тест</button>
       @*                  <button type="button" id="send-quiz-answers" class="btn btn-outline-primary">Отправить тест</button> *@
                    </div>
                </div>
            </div>
        }
        else
        {
            <div class="large">Пока что тут пусто. Создайте новый модуль!</div>
        }
    </div>
    <div class="sidebar-wrapper">
        
    </div>
</div>

<!-- Модальное окно для теста -->
<div class="modal fade" id="quizModal" tabindex="-1" aria-labelledby="quizModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="quizModalLabel">Создать новый тест</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="quiz-id">
                @if (Model.CurrentCourseItem != null)
                {
                    <input type="hidden" id="course-item-id" value="@Model.CurrentCourseItem.Id">
                }
                else
                {
                    <input type="hidden" id="course-item-id">
                }


                <div class="mb-3">
                    <label for="quiz-title" class="form-label">Название теста</label>
                    <input type="text" class="form-control" id="quiz-title" required>
                </div>

                <div class="mb-3">
                    <label for="quiz-type" class="form-label">Тип теста</label>
                    <select class="form-select" id="quiz-type" required>
                        <option value="">Выберите тип</option>
                        <option value="Exam">Экзамен</option>
                        <option value="Test">Тест</option>
                        <option value="Quiz">Викторина</option>
                        <option value="Practice">Практика</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="quiz-description" class="form-label">Описание</label>
                    <textarea class="form-control" id="quiz-description" rows="3"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" id="save-quiz" class="btn btn-outline-primary">Сохранить тест</button>
            </div>
        </div>
    </div>
</div>

<!-- Модальное окно для вопроса -->
<div class="modal fade" id="questionModal" tabindex="-1" aria-labelledby="questionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="questionModalLabel">Добавить вопрос</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="question-id">
                <input type="hidden" id="question-quiz-id">

                <div class="mb-3">
                    <label for="question-type" class="form-label">Тип вопроса</label>
                    <select class="form-select" id="question-type" required>
                        <option value="">Выберите тип</option>
                        <option value="SingleChoice">Один вариант</option>
                        <option value="MultipleChoice">Несколько вариантов</option>
                        <option value="TextAnswer">Текстовый ответ</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label for="question-text" class="form-label">Текст вопроса</label>
                    <textarea class="form-control" id="question-text" rows="3" required></textarea>
                </div>

                <div class="mb-3" id="options-container" style="display: none;">
                    <label for="question-options" class="form-label">Варианты ответов (каждый с новой строки)</label>
                    <textarea class="form-control" id="question-options" rows="5"></textarea>
                </div>

                <div class="mb-3">
                    <label for="correct-answer" class="form-label">Правильный ответ</label>
                    <input type="text" class="form-control" id="correct-answer" required>
                </div>

                <div class="mb-3">
                    <label for="max-score" class="form-label">Максимальный балл</label>
                    <input type="number" class="form-control" id="max-score" min="1" value="1" required>
                </div>

                <div class="mb-3">
                    <label for="question-order" class="form-label">Порядковый номер</label>
                    <input type="number" class="form-control" id="question-order" min="1" value="1" required>
                </div>

                <!-- Предпросмотр вопроса -->
                <div class="preview-container">
                    <h5>Предпросмотр вопроса:</h5>
                    <div id="question-preview" class="mb-3">
                        <p>Текст вопроса появится здесь...</p>
                    </div>
                    <div id="answer-preview" class="answer-section">
                        <div id="options-preview"></div>
                        <div id="text-answer-preview" style="display: none;">
                            <label for="text-answer-input" class="form-label">Ваш ответ:</label>
                            <textarea id="text-answer-input" class="form-control" rows="3"></textarea>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button" id="save-question" class="btn btn-outline-primary">Сохранить вопрос</button>
            </div>
        </div>
    </div>
</div>


